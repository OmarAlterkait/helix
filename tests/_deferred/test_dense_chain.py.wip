def test_no_double_digitize(jaxtpc_data_root):
    sub = _sensor_sample(jaxtpc_data_root)
    Densify()(sub)
    Digitize(pedestal=0)(sub)
    with pytest.raises(RuntimeError):
        Digitize(pedestal=0)(sub)



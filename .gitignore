__pycache__/
*.pyc
*.egg-info/
dist/
build/
.pytest_cache/
figures/
*.npz
# ...except packaged data: helix/tpc/noise.py loads this by DEFAULT
# (DEFAULT_SERIES_SPECTRUM), so an untracked copy means a clone or a wheel
# raises FileNotFoundError on the default path. 3.8 kB.
!helix/tpc/data/*.npz
temp/

# ── research/report tracking (2026-07-23): track the text/code record, not artifacts ──
.pylibs/
.claude/
research/**/artifacts/
research/coeff_foundation_model/fm/slurm_logs/
research/coeff_foundation_model/fm/broken_wr0_backup/
research/coeff_foundation_model/fm/undertuned_lr4e4_backup/
*.pt
*.pth
*.npy
*.h5
*.zip
*.out
*.err
*.log
research/**/*.png
# report figures ARE the record (small, referenced by the tex):
!report/figures/
!report/figures/**
*.done


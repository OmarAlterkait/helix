__pycache__/
*.pyc
*.egg-info/
dist/
build/
.pytest_cache/
figures/
*.npz
# ...except packaged data: helix/tpc/noise.py loads this by DEFAULT
# (DEFAULT_SERIES_SPECTRUM), so an untracked copy means a clone or a wheel
# raises FileNotFoundError on the default path. 3.8 kB.
!helix/tpc/data/*.npz
temp/

# ── retired trees (2026-09-09) ──
# research/ and report/ were the exploratory record. They are purged from this
# history and archived under $HELIX_ARCHIVE/retirement-backups/ as
# research-fm-code_2026-09-09/, helix-research_2026-09-09/, report_2026-09-09/.
# Working copies still sit beside some checkouts, so ignore them outright --
# a stale index in the main worktree had all 668 files staged to come back.
research/
report/

.pylibs/
.claude/

# Artifacts: never in git, whatever produced them.
*.pt
*.pth
*.npy
*.h5
*.png
# ...except a figure a document renders. Same exception shape as the packaged
# npz above. NOT docs/figures/: the `figures/` rule higher up excludes that
# directory outright, and git cannot re-include a file whose parent directory
# is excluded.
!docs/img/*.png
*.zip
*.out
*.err
*.log
*.done

# Run output. `save_path` must resolve through helix.paths (HELIX_EXP), never
# relative to the checkout -- a relative one wrote a run into the repo and four
# of its files were committed.
exp/
